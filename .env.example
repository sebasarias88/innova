# ── Supabase (Project Settings → API Keys) ─────────────────────────────
SUPABASE_URL=https://nidysyylachldwqjzykd.supabase.co
# Publishable key (sb_publishable_…): protected by RLS
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Hplc2xzO6lnNV7HnJW5yaw_4GF_y08P
# Secret key (sb_secret_…): bypasses RLS. Never commit it
# None of these use the NEXT_PUBLIC_ prefix: Supabase is only called from the server
SUPABASE_SECRET_KEY=

# ── Wompi (Dashboard → Desarrolladores) ───────────────────────────────
# sandbox while testing; production only in Vercel, with the pub_prod_ / prod_ keys.
# If any value is missing or does not match WOMPI_ENV, online payment is hidden.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Not used by the code (no server-side transactions); keep it only in the Wompi dashboard.
# WOMPI_PRIVATE_KEY=

# ── E-mail alerts to the owners (Resend) ───────────────────────────────
# Without RESEND_API_KEY nothing is sent (the site works the same).
# RESEND_API_KEY=
# NOTIFY_FROM=INNOVA Seguridad y Sistemas <avisos@innovaseguridad.com.co>

# ── Site ──────────────────────────────────────────────────────────────
# Final public URL (payment return page). Optional until the domain exists:
# Vercel's own URL is used meanwhile.
# SITE_URL=https://innovaseguridad.co
